rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read leaderboard snapshots
    match /leaderboards/{document=**} {
      allow read: if request.auth.uid != null;
      allow write: if false; // Only Cloud Functions can write via service account
    }

    // Users collection
    match /users/{userId} {
      // Allow authenticated users to read all user profiles (for leaderboard queries)
      allow read: if request.auth.uid != null;
      // Allow users to write only their own profile
      allow write: if request.auth.uid == userId;

      // Leaderboard data subcollection
      match /leaderboardData/{document=**} {
        // Allow authenticated users to read any daily leaderboard scores (for ranking queries)
        allow read: if request.auth.uid != null;
        // Allow users to write only their own daily scores
        allow write: if request.auth.uid == userId;
      }
    }

    // Quiz questions collection - allow authenticated users to read
    match /quizzes/{document=**} {
      allow read: if request.auth.uid != null;
      allow write: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
