        "timedExam": {
          "questionCount": 15,
          "timePerQuestionSeconds": 30,
          "autoNextOnTimeout": true
        },
        "reviewMistakes": {
          "questionCount": 15
        }
      },
      "dailySessionTarget": 4,
      "savedTestsLimit": 30
    }
